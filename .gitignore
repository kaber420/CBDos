# =============================================================================
# espOS32 — .gitignore
# =============================================================================

# ─── PlatformIO ───────────────────────────────────────────────────────────────
.pio/
firmware/.pio/
.pioenvs/
.piolibdeps/
.piopm

# ─── Binarios compilados ──────────────────────────────────────────────────────
build/
**/build/
*.bin
*.elf
*.hex
*.out
*.map
*.factory.bin
*.bootloader.bin
*.partitions.bin

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
dist/
.eggs/

# ─── Archivos de respaldo y temporales ────────────────────────────────────────
*_backup_*/
*_backup.*
*.bak
*.tmp
*.swp
*.swo
*~

# ─── Gateway / legacy / prototipos locales ────────────────────────────────────
# Archivos de prueba y código muerto — no forman parte del proyecto principal
gateway/native-legacy-codigomuerto/
gateway/tlvgl_backup/
gateway/test_*.html
gateway/test_*.py

# ─── IDE / Editores ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.project
.cproject
.settings/

# ─── Sistema operativo ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Playwright / Browser testing & perfiles de navegador ────────────────────
test-results/
playwright-report/
playwright/.cache/
.playwright/

# Perfiles de Firefox y Chromium generados por Playwright/tests
**/ff_profile/
**/raw_profile/
**/firefox-profile*/
**/chromium-*/
**/webkit-*/
**/.local-chromium/
**/.local-firefox/
**/.local-webkit/
**/raw-profiles/
**/default-profile/
*.raw-profiles
*.profraw

# ─── Bases de datos ───────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.bd
drafts/aplicaciones/Doom_Plan_Evaluacion_Loader.md
drafts/aplicaciones/Doom_LazyApp_Spec.md
