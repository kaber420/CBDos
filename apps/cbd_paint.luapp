-- @description: Suite retro de dibujo y pixel art tipo MS Paint con zoom, herramientas completas y exportador BMP

-- ─────────────────────────────────────────────────────────────────────────────
-- Paletas de Colores Disponibles
-- ─────────────────────────────────────────────────────────────────────────────
local PALETTES = {
    {
        name = "Clásica (VGA)",
        colors = {
            0x000000, 0x800000, 0x008000, 0x808000,
            0x000080, 0x800080, 0x008080, 0xC0C0C0,
            0x808080, 0xFF0000, 0x00FF00, 0xFFFF00,
            0x0000FF, 0xFF00FF, 0x00FFFF, 0xFFFFFF
        }
    },
    {
        name = "PICO-8",
        colors = {
            0x000000, 0x1D2B53, 0x7E2553, 0x008751,
            0xAB5236, 0x5F574F, 0xC2C3C7, 0xFFF1E8,
            0xFF004D, 0xFFA300, 0xFFEC27, 0x00E436,
            0x29ADFF, 0x83769C, 0xFF77A8, 0xFFCCAA
        }
    },
    {
        name = "Cyberpunk / Neon",
        colors = {
            0x0A0E17, 0x1A2238, 0x4E148C, 0x8500C0,
            0xD600FF, 0xFF0055, 0xFF5722, 0xFFB300,
            0x00E5FF, 0x00F5D4, 0x00B4D8, 0x0077B6,
            0x7209B7, 0xF72585, 0xE0E6ED, 0xFFFFFF
        }
    },
    {
        name = "GameBoy (4-Tonos)",
        colors = {
            0x0F380F, 0x306230, 0x8BAC0F, 0x9BBC0F,
            0x0F380F, 0x306230, 0x8BAC0F, 0x9BBC0F,
            0x0F380F, 0x306230, 0x8BAC0F, 0x9BBC0F,
            0x0F380F, 0x306230, 0x8BAC0F, 0x9BBC0F
        }
    }
}

-- ─────────────────────────────────────────────────────────────────────────────
-- Estado de la Aplicación
-- ─────────────────────────────────────────────────────────────────────────────
local currentPaletteIdx = 1
local primaryColor = 0xFFFFFF
local secondaryColor = 0x000000
local currentTool = "pencil" -- pencil, brush, eraser, bucket, picker, line, rect, circle, text
local brushSize = 2
local shapeFilled = false

-- Dimensiones del Canvas
local CANVAS_W = 420
local CANVAS_H = 340

-- Objetos UI
local canvas = nil
local lblStatus = nil
local lblToolInfo = nil
local lblColorPreview = nil
local paletteButtons = {}

-- Puntos de Trazo / Geometría
local startX, startY = 0, 0
local lastX, lastY = 0, 0
local isDrawing = false

-- ─────────────────────────────────────────────────────────────────────────────
-- Utilidades Gráficas
-- ─────────────────────────────────────────────────────────────────────────────
local function update_status(text)
    if lblStatus then
        local psramMB = cbdos.system.free_psram() / (1024 * 1024)
        local msg = text or string.format("Herramienta: %s | Color: #%06X | PSRAM: %.1f MB", currentTool:upper(), primaryColor, psramMB)
        cbdos.ui.set_text(lblStatus, msg)
    end
end

local function draw_brush_point(cx, cy, color, size)
    if not canvas then return end
    local half = math.floor(size / 2)
    if size <= 1 then
        cbdos.canvas.set_px(canvas, cx, cy, color)
    else
        cbdos.canvas.draw_rect(canvas, cx - half, cy - half, size, size, color, true)
    end
end

-- Interpolación lineal para trazo continuo suave (Bresenham)
local function draw_brush_line(x0, y0, x1, y1, color, size)
    local dx = math.abs(x1 - x0)
    local dy = -math.abs(y1 - y0)
    local sx = x0 < x1 and 1 or -1
    local sy = y0 < y1 and 1 or -1
    local err = dx + dy

    while true do
        draw_brush_point(x0, y0, color, size)
        if x0 == x1 and y0 == y1 then break end
        local e2 = 2 * err
        if e2 >= dy then
            err = err + dy
            x0 = x0 + sx
        end
        if e2 <= dx then
            err = err + dx
            y0 = y0 + sy
        end
    end
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Manejo de Eventos Táctiles en el Canvas
-- ─────────────────────────────────────────────────────────────────────────────
local function handle_canvas_touch(event, x, y)
    if not canvas then return end

    -- Clamping de coordenadas
    x = math.max(0, math.min(CANVAS_W - 1, x))
    y = math.max(0, math.min(CANVAS_H - 1, y))

    if event == "pressed" then
        isDrawing = true
        startX, startY = x, y
        lastX, lastY = x, y

        if currentTool == "pencil" then
            cbdos.canvas.set_px(canvas, x, y, primaryColor)
            cbdos.canvas.refresh(canvas)
        elseif currentTool == "brush" then
            draw_brush_point(x, y, primaryColor, brushSize)
            cbdos.canvas.refresh(canvas)
        elseif currentTool == "eraser" then
            draw_brush_point(x, y, secondaryColor, brushSize * 2)
            cbdos.canvas.refresh(canvas)
        elseif currentTool == "bucket" then
            cbdos.canvas.flood_fill(canvas, x, y, primaryColor)
            update_status(string.format("Relleno completado en (%d, %d)", x, y))
        elseif currentTool == "picker" then
            local picked = cbdos.canvas.get_px(canvas, x, y)
            primaryColor = picked
            update_status(string.format("Color seleccionado: #%06X", picked))
        elseif currentTool == "text" then
            cbdos.canvas.draw_text(canvas, x, y, "CBDos", primaryColor, math.max(1, math.floor(brushSize / 2)))
            cbdos.canvas.refresh(canvas)
            update_status("Texto estampado")
        end

    elseif event == "drag" and isDrawing then
        if currentTool == "pencil" then
            draw_brush_line(lastX, lastY, x, y, primaryColor, 1)
            cbdos.canvas.refresh(canvas)
        elseif currentTool == "brush" then
            draw_brush_line(lastX, lastY, x, y, primaryColor, brushSize)
            cbdos.canvas.refresh(canvas)
        elseif currentTool == "eraser" then
            draw_brush_line(lastX, lastY, x, y, secondaryColor, brushSize * 2)
            cbdos.canvas.refresh(canvas)
        end
        lastX, lastY = x, y

    elseif event == "released" and isDrawing then
        isDrawing = false

        if currentTool == "line" then
            cbdos.canvas.draw_line(canvas, startX, startY, x, y, primaryColor)
            cbdos.canvas.refresh(canvas)
        elseif currentTool == "rect" then
            local rx = math.min(startX, x)
            local ry = math.min(startY, y)
            local rw = math.abs(x - startX) + 1
            local rh = math.abs(y - startY) + 1
            cbdos.canvas.draw_rect(canvas, rx, ry, rw, rh, primaryColor, shapeFilled)
            cbdos.canvas.refresh(canvas)
        elseif currentTool == "circle" then
            local rx = math.abs(x - startX)
            local ry = math.abs(y - startY)
            local radius = math.floor(math.sqrt(rx * rx + ry * ry))
            cbdos.canvas.draw_circle(canvas, startX, startY, radius, primaryColor, shapeFilled)
            cbdos.canvas.refresh(canvas)
        end

        update_status()
    end
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Actualización de Paleta en Pantalla
-- ─────────────────────────────────────────────────────────────────────────────
local function refresh_palette_ui(rowObj)
    local curPal = PALETTES[currentPaletteIdx]
    for i, hex in ipairs(curPal.colors) do
        local btn = paletteButtons[i]
        if btn then
            -- Botón de color directo
        end
    end
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Guardado BMP en MicroSD
-- ─────────────────────────────────────────────────────────────────────────────
local function save_drawing_bmp()
    if not canvas then return end
    local filename = string.format("/sdcard/drawings/art_%d.bmp", cbdos.system.millis())
    local ok = cbdos.canvas.save_bmp(canvas, filename)
    if ok then
        cbdos.ui.show_toast("Guardado: " .. filename)
        update_status("Guardado con éxito en: " .. filename)
        cbdos.audio.beep(880, 80)
    else
        cbdos.ui.show_toast("Error al guardar BMP en MicroSD")
        update_status("Error de I/O en MicroSD")
    end
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Ciclo de Vida de la Aplicación
-- ─────────────────────────────────────────────────────────────────────────────
function on_create(parent)
    local mainCard = cbdos.ui.create_card(parent, -1, -1)

    -- 1. Barra de Herramientas Superior
    local toolRow = cbdos.ui.create_row(mainCard)
    
    cbdos.ui.create_button(toolRow, "✎ Lapiz", function()
        currentTool = "pencil"
        update_status("Modo: Lapiz 1px (Pixel Art)")
    end)

    cbdos.ui.create_button(toolRow, "🖌 Pincel", function()
        currentTool = "brush"
        update_status("Modo: Pincel continuo")
    end)

    cbdos.ui.create_button(toolRow, "▧ Borrador", function()
        currentTool = "eraser"
        update_status("Modo: Borrador")
    end)

    cbdos.ui.create_button(toolRow, "🪣 Bote", function()
        currentTool = "bucket"
        update_status("Modo: Bote de Pintura (Relleno)")
    end)

    cbdos.ui.create_button(toolRow, "💉 Gotero", function()
        currentTool = "picker"
        update_status("Modo: Cuentagotas (Muestrear color)")
    end)

    -- Segunda fila de herramientas geométricas y acciones
    local shapeRow = cbdos.ui.create_row(mainCard)

    cbdos.ui.create_button(shapeRow, "╱ Linea", function()
        currentTool = "line"
        update_status("Modo: Linea recta")
    end)

    cbdos.ui.create_button(shapeRow, "▢ Rect", function()
        currentTool = "rect"
        update_status("Modo: Rectangulo")
    end)

    cbdos.ui.create_button(shapeRow, "◯ Circulo", function()
        currentTool = "circle"
        update_status("Modo: Circulo")
    end)

    cbdos.ui.create_button(shapeRow, "🔤 Texto", function()
        currentTool = "text"
        update_status("Modo: Estampar texto")
    end)

    cbdos.ui.create_button(shapeRow, shapeFilled and "⬛ Lleno" or "⬚ Borde", function(btn)
        shapeFilled = not shapeFilled
        cbdos.ui.show_toast(shapeFilled and "Formas: Relleno solido" or "Formas: Solo contorno")
    end)

    cbdos.ui.create_button(shapeRow, "🗑 Limpiar", function()
        cbdos.canvas.fill(canvas, secondaryColor)
        cbdos.ui.show_toast("Lienzo limpio")
        update_status("Lienzo reiniciado")
    end)

    cbdos.ui.create_button(shapeRow, "💾 Guardar", function()
        save_drawing_bmp()
    end)

    -- 2. Selector de Grosor y Paleta
    local optRow = cbdos.ui.create_row(mainCard)
    
    cbdos.ui.create_button(optRow, "Grosor: 1px", function() brushSize = 1; update_status("Grosor: 1px") end)
    cbdos.ui.create_button(optRow, "Grosor: 2px", function() brushSize = 2; update_status("Grosor: 2px") end)
    cbdos.ui.create_button(optRow, "Grosor: 4px", function() brushSize = 4; update_status("Grosor: 4px") end)
    cbdos.ui.create_button(optRow, "Grosor: 8px", function() brushSize = 8; update_status("Grosor: 8px") end)

    cbdos.ui.create_button(optRow, "🎨 Paleta: " .. PALETTES[currentPaletteIdx].name, function(btn)
        currentPaletteIdx = (currentPaletteIdx % #PALETTES) + 1
        local pal = PALETTES[currentPaletteIdx]
        primaryColor = pal.colors[1]
        secondaryColor = pal.colors[#pal.colors]
        cbdos.ui.show_toast("Paleta: " .. pal.name)
        update_status("Paleta cambiada a " .. pal.name)
    end)

    -- 3. Área del Lienzo Central
    local canvasCard = cbdos.ui.create_sunken_card(mainCard, CANVAS_W + 16, CANVAS_H + 16)
    canvas = cbdos.ui.create_canvas(canvasCard, CANVAS_W, CANVAS_H)
    if canvas then
        cbdos.canvas.fill(canvas, 0x000000)
        cbdos.canvas.on_touch(canvas, handle_canvas_touch)
    end

    -- 4. Barra de Paleta de Colores Rápida (16 botones)
    local palCard = cbdos.ui.create_card(mainCard, -1, 70)
    local palRow1 = cbdos.ui.create_row(palCard)
    local palRow2 = cbdos.ui.create_row(palCard)

    local activePal = PALETTES[currentPaletteIdx].colors
    for i = 1, 8 do
        local col = activePal[i]
        cbdos.ui.create_button(palRow1, string.format("#%06X", col), function()
            primaryColor = col
            update_status(string.format("Color Primario: #%06X", col))
        end)
    end
    for i = 9, 16 do
        local col = activePal[i]
        cbdos.ui.create_button(palRow2, string.format("#%06X", col), function()
            primaryColor = col
            update_status(string.format("Color Primario: #%06X", col))
        end)
    end

    -- 5. Barra de Estado
    lblStatus = cbdos.ui.create_label(mainCard, "CBD Paint listo. Toca y arrastra para dibujar.")
    cbdos.ui.set_color(lblStatus, 0x38BDF8)
    cbdos.ui.set_font_size(lblStatus, 12)

    update_status()
end

function on_show()
    update_status()
end

function on_destroy()
    print("[CBD Paint] Aplicación cerrada.")
end
