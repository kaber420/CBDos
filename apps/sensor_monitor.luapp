-- @name: Monitor Telemetria
-- @icon: LV_SYMBOL_SETTINGS
-- @accent: #EC4899
-- @author: CyberDeck Team
-- @version: 1.0
-- @description: Monitor de estado y telemetría de hardware en tiempo real

local lblHeap = nil
local lblPsram = nil
local lblTemp = nil
local lblUptime = nil

function update_telemetry()
    if lblHeap then
        local heap = cbdos.system.free_heap() / 1024
        cbdos.ui.set_text(lblHeap, string.format("Heap Libre: %.1f KB", heap))
    end
    if lblPsram then
        local psram = cbdos.system.free_psram() / (1024 * 1024)
        cbdos.ui.set_text(lblPsram, string.format("PSRAM Libre: %.2f MB", psram))
    end
    if lblTemp then
        local temp = cbdos.system.cpu_temp()
        cbdos.ui.set_text(lblTemp, string.format("CPU Temp: %.1f C", temp))
    end
    if lblUptime then
        local sec = cbdos.system.get_time() / 1000
        cbdos.ui.set_text(lblUptime, string.format("Uptime: %d s", math.floor(sec)))
    end
end

function on_create(parent)
    local card = cbdos.ui.create_card(parent, -1, -1)

    local title = cbdos.ui.create_label(card, "TELEMETRIA DEL SISTEMA")
    cbdos.ui.set_color(title, 0xEC4899)
    cbdos.ui.set_font_size(title, 16)

    local sunken = cbdos.ui.create_sunken_card(card, -1, 140)
    
    lblHeap = cbdos.ui.create_label(sunken, "Heap Libre: --")
    cbdos.ui.set_font_size(lblHeap, 14)
    
    lblPsram = cbdos.ui.create_label(sunken, "PSRAM Libre: --")
    cbdos.ui.set_font_size(lblPsram, 14)
    
    lblTemp = cbdos.ui.create_label(sunken, "CPU Temp: --")
    cbdos.ui.set_font_size(lblTemp, 14)

    lblUptime = cbdos.ui.create_label(sunken, "Uptime: --")
    cbdos.ui.set_font_size(lblUptime, 14)

    update_telemetry()

    local row = cbdos.ui.create_row(card)
    cbdos.ui.create_button(row, "Actualizar", function()
        update_telemetry()
        cbdos.ui.show_toast("Metricas actualizadas")
    end)
end

function on_show()
    update_telemetry()
end

function on_destroy()
    print("[Sensor Monitor] App cerrada")
end
