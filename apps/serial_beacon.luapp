-- @name: Beacon Serie
-- @icon: LV_SYMBOL_KEYBOARD
-- @accent: #3B82F6
-- @author: CyberDeck Team
-- @version: 1.0
-- @description: Herramienta para transmision y prueba de comandos por UART

local lblLog = nil

function on_create(parent)
    local card = cbdos.ui.create_card(parent, -1, -1)

    local title = cbdos.ui.create_label(card, "TRANSMISOR UART BEACON")
    cbdos.ui.set_color(title, 0x3B82F6)
    cbdos.ui.set_font_size(title, 16)

    local logBox = cbdos.ui.create_sunken_card(card, -1, 100)
    lblLog = cbdos.ui.create_label(logBox, "UART Listo. Pulsa un boton para transmitir.")
    cbdos.ui.set_color(lblLog, 0x94A3B8)
    cbdos.ui.set_font_size(lblLog, 12)

    local row1 = cbdos.ui.create_row(card)
    cbdos.ui.create_button(row1, "Ping AT", function()
        cbdos.uart.init(115200)
        cbdos.uart.write("AT\r\n")
        cbdos.ui.set_text(lblLog, "TX -> AT\\r\\n")
        cbdos.ui.show_toast("Comando AT enviado")
    end)

    cbdos.ui.create_button(row1, "Status AT", function()
        cbdos.uart.init(115200)
        cbdos.uart.write("AT+GMR\r\n")
        cbdos.ui.set_text(lblLog, "TX -> AT+GMR\\r\\n")
        cbdos.ui.show_toast("Comando AT+GMR enviado")
    end)

    local row2 = cbdos.ui.create_row(card)
    cbdos.ui.create_button(row2, "Beacon Ping", function()
        cbdos.uart.init(115200)
        cbdos.uart.write("[CBDOS_BEACON_PING]\n")
        cbdos.ui.set_text(lblLog, "TX -> [CBDOS_BEACON_PING]")
        cbdos.ui.show_toast("Beacon transmitido")
    end)
end

function on_destroy()
    print("[Serial Beacon] Cerrado")
end
