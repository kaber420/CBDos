-- @name: Winamp Retro
-- @icon: LV_SYMBOL_AUDIO
-- @accent: #00F5D4
-- @author: CyberDeck Team
-- @version: 1.2
-- @description: Reproductor de audio retro con escaneo recursivo de archivos MP3 en la MicroSD

local playlist = {}
local currentIndex = 1
local isPlaying = false

local lblTitle = nil
local lblTrack = nil
local lblStatus = nil
local lblCount = nil

local function is_audio_file(name)
    if not name or #name < 4 then return false end
    local lower = string.lower(name)
    return string.sub(lower, -4) == ".mp3" 
        or string.sub(lower, -4) == ".wav" 
        or string.sub(lower, -4) == ".aac" 
        or string.sub(lower, -4) == ".m4a"
end

local function scan_folder(dirPath)
    local entries = cbdos.storage.list_dir(dirPath)
    if not entries then return end

    for _, entry in ipairs(entries) do
        local isDir = entry.isDirectory or entry.is_directory or entry.is_dir
        local fullPath = dirPath .. "/" .. entry.name

        if isDir then
            -- Si es carpeta, buscar pistas dentro (ej: /sdcard/music, /sdcard/musica)
            if string.sub(entry.name, 1, 1) ~= "." then
                local subEntries = cbdos.storage.list_dir(fullPath)
                if subEntries then
                    for _, sub in ipairs(subEntries) do
                        local subIsDir = sub.isDirectory or sub.is_directory or sub.is_dir
                        if not subIsDir and is_audio_file(sub.name) then
                            table.insert(playlist, {
                                name = sub.name,
                                fullPath = fullPath .. "/" .. sub.name
                            })
                        end
                    end
                end
            end
        else
            -- Si es archivo directo
            if is_audio_file(entry.name) then
                table.insert(playlist, {
                    name = entry.name,
                    fullPath = fullPath
                })
            end
        end
    end
end

local function scan_music_files()
    playlist = {}
    
    -- 1. Intentar /sdcard
    scan_folder("/sdcard")
    
    -- 2. Si no hay nada, intentar raíz /
    if #playlist == 0 then
        scan_folder("/")
    end
    
    print(string.format("[Winamp Retro] Escaneo completado. Pistas encontradas: %d", #playlist))
end

local function update_track_display()
    if #playlist == 0 then
        if lblTrack then
            cbdos.ui.set_text(lblTrack, "Sin canciones (.mp3) en la SD")
            cbdos.ui.set_color(lblTrack, 0xEF4444)
        end
        if lblStatus then
            cbdos.ui.set_text(lblStatus, "Copia archivos .mp3 en /sdcard/music")
            cbdos.ui.set_color(lblStatus, 0x94A3B8)
        end
        if lblCount then
            cbdos.ui.set_text(lblCount, "Pistas: 0")
        end
        return
    end

    if currentIndex < 1 then currentIndex = #playlist end
    if currentIndex > #playlist then currentIndex = 1 end

    local current = playlist[currentIndex]
    if lblTrack then
        cbdos.ui.set_text(lblTrack, string.format("[%d/%d] %s", currentIndex, #playlist, current.name))
        cbdos.ui.set_color(lblTrack, 0x10B981)
    end
    if lblCount then
        cbdos.ui.set_text(lblCount, string.format("Lista: %d pistas", #playlist))
    end
end

local function play_current()
    if #playlist == 0 then
        cbdos.ui.show_toast("No hay pistas disponibles")
        return
    end

    local track = playlist[currentIndex]
    isPlaying = true
    cbdos.audio.play_file(track.fullPath)
    if lblStatus then
        cbdos.ui.set_text(lblStatus, "Estado: >> REPRODUCIENDO")
        cbdos.ui.set_color(lblStatus, 0x00F5D4)
    end
    cbdos.ui.show_toast("Sonando: " .. track.name)
end

local function stop_playback()
    isPlaying = false
    cbdos.audio.stop()
    if lblStatus then
        cbdos.ui.set_text(lblStatus, "Estado: [] DETENIDO")
        cbdos.ui.set_color(lblStatus, 0x94A3B8)
    end
    cbdos.ui.show_toast("Reproduccion detenida")
end

function on_create(parent)
    scan_music_files()

    local card = cbdos.ui.create_card(parent, -1, -1)

    -- Cabecera Retro
    local hdrRow = cbdos.ui.create_row(card)
    local hdr = cbdos.ui.create_label(hdrRow, "== WINAMP RETRO ==")
    cbdos.ui.set_color(hdr, 0x00F5D4)
    cbdos.ui.set_font_size(hdr, 16)

    lblCount = cbdos.ui.create_label(hdrRow, string.format("Pistas: %d", #playlist))
    cbdos.ui.set_color(lblCount, 0x94A3B8)
    cbdos.ui.set_font_size(lblCount, 12)

    -- Display LCD Hundido Verde/Cian
    local displayBox = cbdos.ui.create_sunken_card(card, -1, 70)
    
    lblTrack = cbdos.ui.create_label(displayBox, "Cargando lista de pistas...")
    cbdos.ui.set_color(lblTrack, 0x10B981)
    cbdos.ui.set_font_size(lblTrack, 14)

    lblStatus = cbdos.ui.create_label(displayBox, "Estado: [] DETENIDO")
    cbdos.ui.set_color(lblStatus, 0x94A3B8)
    cbdos.ui.set_font_size(lblStatus, 12)

    update_track_display()

    -- Fila de Botones de Control de Transporte
    local rowTransport = cbdos.ui.create_row(card)

    cbdos.ui.create_button(rowTransport, "|<<", function()
        if #playlist > 0 then
            currentIndex = currentIndex - 1
            if currentIndex < 1 then currentIndex = #playlist end
            update_track_display()
            if isPlaying then play_current() end
        end
    end)

    cbdos.ui.create_button(rowTransport, "Play", function()
        play_current()
    end)

    cbdos.ui.create_button(rowTransport, "Stop", function()
        stop_playback()
    end)

    cbdos.ui.create_button(rowTransport, ">>|", function()
        if #playlist > 0 then
            currentIndex = currentIndex + 1
            if currentIndex > #playlist then currentIndex = 1 end
            update_track_display()
            if isPlaying then play_current() end
        end
    end)

    -- Fila de Herramientas y Rescan
    local rowTools = cbdos.ui.create_row(card)

    cbdos.ui.create_button(rowTools, "Escanear SD", function()
        scan_music_files()
        currentIndex = 1
        update_track_display()
        cbdos.ui.show_toast(string.format("Escaneo: %d pistas encontradas", #playlist))
    end)

    cbdos.ui.create_button(rowTools, "Beep Test", function()
        cbdos.audio.beep(1000, 150)
    end)

    -- Slider de Volumen Master
    local lblVol = cbdos.ui.create_label(card, "Volumen:")
    cbdos.ui.set_font_size(lblVol, 12)
    cbdos.ui.set_color(lblVol, 0x94A3B8)

    cbdos.ui.create_slider(card, 0, 100, 75, function(val)
        cbdos.audio.set_volume(val)
    end)
end

function on_show()
    print("[Winamp Retro] App visible")
end

function on_hide()
    print("[Winamp Retro] App oculta")
end

function on_destroy()
    if isPlaying then
        cbdos.audio.stop()
    end
    print("[Winamp Retro] Detenido y recursos liberados")
end
