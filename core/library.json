{
  "name": "cbdos-core",
  "version": "0.2.0",
  "description": "Core agnostico de CyBerDeck OS",
  "build": {
    "includeDir": "include",
    "srcDir": "src",
    "flags": [
      "-I include",
      "-I src/system",
      "-I src/ui",
      "-I src/ui/components",
      "-I src/ui/views",
      "-I src/ui/views/utilities",
      "-I src/apps/meshcore",
      "-I src/tlv",
      "-I src/mesh",
      "-I src/audio",
      "-I src/audio/libhelix/src",
      "-I src/audio/libhelix/src/utils",
      "-I src/audio/libhelix/src/libhelix-mp3",
      "-I src/audio/libhelix/src/libhelix-aac",
      "-I src/lua",
      "-I src/lua/liblua",
      "-DESP32",
      "-DUSE_DEFAULT_STDLIB",
      "-DHELIX_LOGGING_ACTIVE=0"
    ]
  }
}
